.continue/
.cursor/
.windsurf/
.vscode/
.idea/

# generated outputs (regenerate with the scripts; do not version)
results/
outputs/
*.parquet
!hazardlab/data/*.csv

# editor / OS noise
.DS_Store
Thumbs.db
desktop.ini
*.bak
*.orig
*.prebrand
*~
